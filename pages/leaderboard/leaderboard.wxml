<!-- pages/leaderboard/leaderboard.wxml -->
<view class="container">
  <view class="eyebrow">LEADERBOARD · 年级天梯</view>
  <view class="title">{{examName || ('考试 #' + examId)}}</view>
  <view class="sub lb-sub">年级成绩天梯 · 前十</view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-card"><view class="sk sk-title"></view><view class="sk sk-num"></view></view>
    <view class="sk-card"><view class="sk sk-line w-80"></view><view class="sk sk-line w-60"></view><view class="sk sk-line w-40"></view></view>
  </view>

  <view wx:elif="{{error}}" class="empty {{ready ? 'show' : ''}}" bindtap="onRetry">{{error}} · 点击重试</view>

  <block wx:elif="{{enabled && list.length > 0}}">
    <!-- Top3 领奖台 -->
    <view class="podium anim {{ready ? 'show' : ''}}">
      <view class="pod pod-2" wx:if="{{list[1]}}">
        <view class="pod-medal">{{list[1].rank}}</view>
        <view class="pod-name">{{list[1].name}}</view>
        <view class="pod-score">{{list[1].score}}</view>
      </view>
      <view class="pod pod-1" wx:if="{{list[0]}}">
        <view class="pod-medal">{{list[0].rank}}</view>
        <view class="pod-name">{{list[0].name}}</view>
        <view class="pod-score">{{list[0].score}}</view>
      </view>
      <view class="pod pod-3" wx:if="{{list[2]}}">
        <view class="pod-medal">{{list[2].rank}}</view>
        <view class="pod-name">{{list[2].name}}</view>
        <view class="pod-score">{{list[2].score}}</view>
      </view>
    </view>

    <!-- 完整榜单 -->
    <view class="section-title">完整榜单</view>
    <view class="card lb-list anim {{ready ? 'show' : ''}}" style="animation-delay: 80ms">
      <view class="lb-row {{item.isMe ? 'me' : ''}}" wx:for="{{list}}" wx:key="studentId">
        <text class="lb-rank r{{item.rank <= 3 ? item.rank : 'n'}}">{{item.rank}}</text>
        <text class="lb-name">{{item.name}}</text>
        <text class="lb-score">{{item.score}}</text>
      </view>
    </view>

    <!-- 我的排名 -->
    <view wx:if="{{mine}}" class="card mine-card anim {{ready ? 'show' : ''}}" style="animation-delay: 120ms">
      <text class="muted">我的排名</text>
      <view class="mine-row">
        <text class="mine-rank num">{{mine.rank == null ? '—' : mineRank}}</text>
        <text class="mine-score">{{mine.score}}</text>
      </view>
    </view>

    <button wx:if="{{enabled}}" class="btn out lb-save" bindtap="onSaveBoardCard">保存天梯卡 ›</button>
  </block>

  <view wx:else class="empty {{ready ? 'show' : ''}}">
    {{enabled ? '本次考试暂无天梯数据' : '天梯功能暂未开启'}}
  </view>
</view>
