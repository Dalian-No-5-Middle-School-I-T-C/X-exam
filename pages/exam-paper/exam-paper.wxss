/* pages/exam-paper/exam-paper.wxss */
.answers {
  padding: 4rpx 28rpx;
  margin-bottom: 10rpx;
}
.ans-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.ans-row:last-child { border-bottom: none; }
.ans-label {
  flex-shrink: 0;
  min-width: 150rpx;
  font-size: 26rpx;
  color: var(--text-3);
}
.ans-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  word-break: break-word;
}

/* 每张原卷页卡：图片 + 本页答案 */
.page {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 0;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}
.page-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.page-no {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 700;
}
.page-img {
  width: 100%;
  border-radius: 0;
  background: #fff;
  border: 1rpx solid var(--border);
}
.page-file {
  padding: 28rpx 0;
  text-align: center;
}
.page-answers {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--border);
}
.pa-row {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  padding: 12rpx 0;
}
.pa-label {
  flex-shrink: 0;
  min-width: 140rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.pa-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  word-break: break-word;
}

/* 答案原文件（PDF / DOCX）：小程序不能内联，给一个明确的点开入口。
   用 view 而不是 button —— 微信基础库会给 button 注入 min-height/line-height/margin:auto，
   这一页的卡宽是内容驱动的，套 button 需要逐条复位，收益为零。 */
.file-warn {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--warning);
  background: var(--paper-2);
  border-left: 6rpx solid var(--warning);
}
.afile {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 22rpx 24rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--border);
}
.afile:active { background: var(--brand-bg); }
.afile-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.afile-kind {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--brand);
}
.afile-hint {
  font-size: 24rpx;
  color: var(--text-3);
  overflow-wrap: break-word;
}
.afile-go {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-3);
}

/* 本人作答图块（横向滚动，复用 detail 规格） */
.imgs { white-space: nowrap; margin: 16rpx 0; }
.img-wrap {
  display: inline-block;
  width: 360rpx;
  margin-right: 18rpx;
  vertical-align: top;
}
.crop {
  width: 360rpx;
  border-radius: 0;
  background: #fff;
  border: 1rpx solid var(--border);
}
.img-title {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 10rpx;
  text-align: center;
}
