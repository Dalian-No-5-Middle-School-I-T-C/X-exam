/* pages/landing/landing.wxss — editorial-brutalist */
.landing { padding: 40rpx 32rpx 60rpx; }
.hero-sec { text-align: center; margin: 60rpx 0 36rpx; }
.logo {
  display: inline-flex; align-items: center; justify-content: center;
  width: 96rpx; height: 96rpx; background: var(--blue); color: #fff;
  font-weight: 800; font-size: 40rpx; letter-spacing: 1rpx;
  border: 1rpx solid var(--ink); box-shadow: var(--shadow-hard);
}
.h-title { font-size: 48rpx; font-weight: 800; color: var(--text-1); margin: 24rpx 0 8rpx; }
.eyebrow { font-family: var(--mono); font-size: 22rpx; letter-spacing: 2rpx; color: var(--text-3); }

.invite-badge {
  display: block; text-align: center; margin: 0 0 24rpx;
  background: var(--blue-soft); color: var(--blue); border: 1rpx solid var(--blue-bd);
  font-size: 24rpx; padding: 14rpx; font-weight: 600;
}

.info { margin-bottom: 28rpx; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--border); }
.info-row:last-child { border-bottom: none; }
.info-row .label { color: var(--text-3); font-size: 26rpx; }
.info-row .val { color: var(--text-1); font-size: 28rpx; font-weight: 600; }

.h-feats { display: flex; flex-direction: column; gap: 10rpx; margin: 8rpx 0 40rpx; }
.h-feat { color: var(--text-3); font-size: 26rpx; }

.enter-btn { width: 100%; height: 92rpx; margin-top: 8rpx; }

.foot { text-align: center; color: var(--text-3); font-size: 22rpx; margin-top: 40rpx; text-decoration: underline; }
