/* pages/t-exams/t-exams.wxss */
.skeleton { margin-top: 24rpx; }

.ovw {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 26rpx 0;
}
.ovw-item { flex: 1; text-align: center; }
.ovw-num {
  font-family: var(--font-mono);
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.toolbar { margin: 28rpx 0 14rpx; }
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 0;
  padding: 0 22rpx;
  height: 80rpx;
}
.search { flex: 1; color: var(--ink); font-size: 28rpx; height: 80rpx; }
.ph { color: var(--gray); }

.chips { white-space: nowrap; margin-bottom: 8rpx; }
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  border-radius: var(--r-pill);
  background: #fff;
  color: var(--gray);
  font-size: 24rpx;
  border: 1rpx solid var(--line);
}
.chip.on {
  background: var(--blue-soft);
  color: var(--blue);
  border-color: var(--blue-bd);
  font-weight: 600;
}

.list { margin-top: 12rpx; }

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
}
.row-main { flex: 1; min-width: 0; }
.row-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0;
  /* break-all 会在「2026.9.22」中间硬切；只在整词放不下时才断 */
  overflow-wrap: break-word;
}
.row-meta { display: block; margin-top: 6rpx; }
.row-nums { display: flex; align-items: baseline; margin-top: 16rpx; }
.row-num { font-size: 32rpx; margin-right: 10rpx; }
.row-cap { margin-right: 26rpx; }

.row-side { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.row-arrow { font-size: 34rpx; color: var(--gray); line-height: 1; }

.err-box { color: var(--err); border-color: var(--err-bd); background: var(--err-soft); }
.empty-hint { margin-top: 10rpx; font-size: 24rpx; color: var(--gray); font-weight: 400; }

/* 本页不是 tabBar 页面，需自带回「我的」的入口 */
.foot { display: flex; justify-content: center; margin-top: 32rpx; }
.foot-btn { width: 320rpx; }
