<!-- pages/profile/profile.wxml -->
<view class="container">
  <view class="eyebrow">STUDENT · 学生档案</view>
  <view class="title">我的</view>

  <view class="card user anim {{ready ? 'show' : ''}}">
    <view class="avatar">{{nameInitial}}</view>
    <view class="u-info">
      <view class="u-name">{{user.name}}</view>
      <view class="muted" wx:if="{{user.student_number}}">学号 {{user.student_number}}</view>
      <view class="muted" wx:if="{{user.role_display_name}}">{{user.role_display_name}}</view>
    </view>
  </view>

  <view class="section-title">AI 成绩报告</view>
  <button class="btn-primary ai-btn" loading="{{aiLoading}}" bindtap="onAi">生成我的分析报告</button>
  <view wx:if="{{aiError}}" class="empty ai-err">{{aiError}}</view>

  <view wx:if="{{aiReport.isText}}" class="card ai-report">
    <text class="ai-text" user-select="true" space="nbsp">{{aiReport.text}}</text>
  </view>
  <view wx:elif="{{aiReport.overall || aiReport.weak.length || aiReport.next.length || aiReport.teach.length || aiReport.cave.length}}" class="card ai-report">
    <view wx:if="{{aiReport.overall}}" class="ai-judge">{{aiReport.overall}}</view>

    <view wx:if="{{aiReport.weak.length > 0}}" class="ai-block">
      <view class="ai-h">薄弱点</view>
      <view wx:for="{{aiReport.weak}}" wx:key="*this" class="ai-li">· {{item}}</view>
    </view>

    <view wx:if="{{aiReport.next.length > 0}}" class="ai-block">
      <view class="ai-h">下一步</view>
      <view wx:for="{{aiReport.next}}" wx:key="*this" class="ai-li">· {{item}}</view>
    </view>

    <view wx:if="{{aiReport.teach.length > 0}}" class="ai-block">
      <view class="ai-h">建议</view>
      <view wx:for="{{aiReport.teach}}" wx:key="*this" class="ai-li">· {{item}}</view>
    </view>

    <view wx:if="{{aiReport.cave.length > 0}}" class="ai-block">
      <view class="ai-h">说明</view>
      <view wx:for="{{aiReport.cave}}" wx:key="*this" class="ai-li muted">{{item}}</view>
    </view>
  </view>

  <view class="section-title">消息提醒</view>
  <view class="card sub-card anim {{ready ? 'show' : ''}}" style="animation-delay: 60ms">
    <view class="sub-row">
      <view>
        <view class="sub-t">成绩发布提醒</view>
        <view class="muted sub-d" wx:if="{{subReady}}">新成绩发布时将通知你</view>
        <view class="muted sub-d" wx:else>功能筹备中</view>
      </view>
      <switch checked="{{subOn}}" disabled="{{!subReady}}" color="#2E44FF" bindchange="onToggleSub" />
    </view>
  </view>

  <view class="section-title">关于</view>
  <view class="card about anim {{ready ? 'show' : ''}}" style="animation-delay: 100ms">
    <view class="muted">Project-X 学生成绩小程序</view>
    <view class="muted">数据由学校 Project-X 阅卷系统提供</view>
  </view>

  <button class="btn dan logout-btn" bindtap="onLogout">退出登录</button>
</view>
