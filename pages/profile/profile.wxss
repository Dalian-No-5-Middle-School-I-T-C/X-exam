/* pages/profile/profile.wxss */
.user {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--blue);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: none;
}
.u-name { font-size: 32rpx; font-weight: 600; color: var(--text-1); }
.u-info .muted { font-size: 24rpx; margin-top: 6rpx; }

.ai-btn { margin: 12rpx 0 18rpx; font-size: 28rpx; }
.ai-err { color: var(--warning); }
.ai-report { margin-top: 12rpx; }
.ai-judge {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-1);
  margin-bottom: 18rpx;
}
.ai-block { margin-bottom: 18rpx; }
.ai-h {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 10rpx;
}
.ai-li {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-2);
}

.ai-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--text-2);
  white-space: pre-wrap;
  word-break: break-word;
}
.sub-card { padding: 8rpx 28rpx; }
.sub-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; }
.sub-t { font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.sub-d { font-size: 24rpx; margin-top: 6rpx; }

.about { font-size: 24rpx; color: var(--text-3); }
.logout-btn {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
}
.logout-btn::after { border: none; }

/* profile 页呼吸感与按钮居中（2026-08-09） */
.eyebrow { margin-bottom: 8rpx; }
.title { margin-bottom: 24rpx; }
.section-title { margin: 56rpx 0 22rpx; }
.user { gap: 32rpx; padding: 32rpx; }
.u-info .muted { margin-top: 8rpx; }
.ai-btn { margin: 16rpx 0 28rpx; }
.sub-card { padding: 14rpx 28rpx; }
.about { padding: 32rpx; }
.about .muted + .muted { margin-top: 10rpx; }
.logout-btn {
  width: 70%;
  max-width: 480rpx;
  margin: 52rpx auto 0;
  display: flex;
}
