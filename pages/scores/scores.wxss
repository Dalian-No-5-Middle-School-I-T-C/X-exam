/* pages/scores/scores.wxss — editorial-brutalist */
.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.hero-sub { font-size: 24rpx; color: var(--text-3); margin-bottom: 6rpx; }
.cache-tag {
  font-size: 22rpx;
  color: var(--text-3);
  background: #fff;
  border: 1rpx solid var(--border-2);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

/* 最新大卡：蓝实底 + 黑硬阴影（重点卡） */
.hero {
  background: var(--blue);
  border-radius: 0;
  border: 1rpx solid var(--ink);
  padding: 32rpx;
  color: #fff;
  box-shadow: var(--shadow-hard);
}
.hero:active { background: var(--blue-deep); }
.hero .eyebrow { color: rgba(255, 255, 255, 0.72); margin-bottom: 10rpx; }
.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.hero-name { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.hero-exam { font-size: 32rpx; font-weight: 700; }
.hero .tag {
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
}
.hero-change { font-size: 30rpx; font-weight: 700; }
.hero-change.up { color: #EAF0FF; }
.hero-change.down { color: #FFC2CB; }
.hero-change.flat { color: rgba(255, 255, 255, 0.75); }

.hero-score {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.05;
  margin: 12rpx 0 4rpx;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
.hero-total { font-size: 32rpx; font-weight: 500; opacity: 0.8; margin-left: 8rpx; }

.hero-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}
.hero-stat { text-align: center; flex: 1; }
.hero-num {
  font-size: 40rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.hero-stat .muted {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 工具栏 */
.toolbar { margin: 28rpx 0 18rpx; }
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 0;
  padding: 0 22rpx;
  height: 80rpx;
  box-shadow: none;
}
.search {
  flex: 1;
  color: var(--text-1);
  font-size: 28rpx;
  height: 80rpx;
}
.ph { color: #B0B0B8; }

.chips {
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--text-3);
  font-size: 24rpx;
  border: 1rpx solid var(--border);
}
.chip.on {
  background: var(--blue-soft);
  color: var(--blue);
  border-color: var(--blue-bd);
  font-weight: 600;
}
.list { margin-top: 12rpx; }

.hero-actions { margin-top: 18rpx; }
/* 天梯入口：蓝色描边胶囊 */
.ghost-btn {
  background: #fff;
  color: var(--blue);
  border: 1rpx solid var(--blue);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
}
.ghost-btn::after { border: none; }
.ghost-btn:active { background: var(--blue-soft); transform: scale(0.98); }

/* 总览统计卡（复用 .card 直角） */
.ovw {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.ovw-item { flex: 1; text-align: center; position: relative; }
.ovw-item::after {
  content: ''; position: absolute; right: 0; top: 14rpx; bottom: 14rpx;
  width: 1rpx; background: var(--border);
}
.ovw-item:last-child::after { display: none; }
.ovw-num { font-size: 40rpx; font-weight: 800; color: var(--text-1); line-height: 1.1; font-variant-numeric: tabular-nums; }
.ovw-num.sm { font-size: 28rpx; font-weight: 700; }
.ovw-item .muted { margin-top: 6rpx; }

/* 分析入口 */
.entry-row { display: flex; gap: 18rpx; margin-top: 20rpx; }
.entry {
  flex: 1; display: flex; align-items: center; gap: 16rpx;
  background: var(--card-bg); border: 1rpx solid var(--border);
  border-radius: 0; padding: 24rpx; box-shadow: none;
}
.entry:active { background: #FAF8F3; }
.entry-ico {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.entry-ico--subj { background-image: url("data:image/svg+xml;base64,"); }
.entry-ico--sem { background-image: url("data:image/svg+xml;base64,"); }
.entry-txt { flex: 1; }
.entry-title { font-size: 28rpx; font-weight: 700; color: var(--text-1); }
.entry-arrow { font-size: 36rpx; color: var(--text-3); }
