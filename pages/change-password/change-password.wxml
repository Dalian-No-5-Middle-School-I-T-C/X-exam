<view class="container login">
  <view class="hero-sec anim {{ready ? 'show' : ''}}">
    <view class="logo">PX</view>
    <view class="h-title">设置新密码</view>
    <view class="eyebrow">PROJECT-X / 首次登录</view>
    <view class="h-feats">
      <text class="h-feat">· 修改成功后需重新登录</text>
      <text class="h-feat">· 新密码至少 6 位</text>
    </view>
  </view>

  <view class="card card--hard anim {{ready ? 'show' : ''}}" style="animation-delay: 80ms">
    <view class="field">
      <text class="label">当前密码</text>
      <input class="input" password placeholder="请输入当前密码" placeholder-class="ph" value="{{oldPassword}}" bindinput="onOld" />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password placeholder="请输入新密码（至少 6 位）" placeholder-class="ph" value="{{newPassword}}" bindinput="onNew" />
    </view>
    <view class="field">
      <text class="label">确认新密码</text>
      <input class="input" password placeholder="请再次输入新密码" placeholder-class="ph" value="{{confirm}}" bindinput="onConfirm" />
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <button class="btn-primary login-btn" loading="{{loading}}" bindtap="onSubmit">确认修改</button>
  </view>
</view>
