/* pages/detail/detail.wxss */
.q-card {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 0;
  padding: 4rpx 28rpx;
  margin-bottom: 10rpx;
  box-shadow: none;
}
.q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.q-row:last-child { border-bottom: none; }
.q-no { font-size: 28rpx; color: var(--text-2); font-weight: 500; }
.q-score { font-size: 30rpx; font-weight: 700; }
.q-avg { font-size: 24rpx; }

.imgs { white-space: nowrap; margin: 16rpx 0; }
.img-wrap {
  display: inline-block;
  width: 360rpx;
  margin-right: 18rpx;
  vertical-align: top;
}
.crop {
  width: 360rpx;
  border-radius: 0;
  background: #fff;
  border: 1rpx solid var(--border);
  box-shadow: none;
}
.img-title {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 10rpx;
  text-align: center;
}

.ai-btn { margin: 12rpx 0 18rpx; font-size: 28rpx; }
.ai-err { color: var(--warning); }
.ai-report { margin-top: 12rpx; }
.ai-judge {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-1);
  margin-bottom: 18rpx;
}
.ai-block { margin-bottom: 18rpx; }
.ai-h {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 10rpx;
}
.ai-li {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-2);
}
.ai-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--text-2);
  white-space: pre-wrap;
  word-break: break-word;
}
