/* pages/trends/trends.wxss */
.share-btn {
  width: 100%;
  height: 84rpx;
  margin: 8rpx 0 18rpx;
}
.chart {
  width: 100%;
  height: 440rpx;
  background: var(--card-bg);
  border-radius: 0;
  border: 1rpx solid var(--border);
  box-shadow: none;
}
.radar { height: 460rpx; }

/* 段内小标题：页面级 section-title 之下还有一层，用更小的字重区分 */
.sub-label {
  margin: 24rpx 0 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
}

.legend {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  margin: 14rpx 0 8rpx;
  font-size: 24rpx;
}
.lg.brand { color: var(--brand); font-weight: 600; }
.lg.muted { color: var(--text-3); }
.lg.warn { color: var(--warning); font-weight: 600; }
/* 雷达图图例带色块，折线图图例只染文字 */
.lg.sw { display: flex; align-items: center; }
.lg.sw::before {
  content: '';
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
}
.lg.sw.brand::before { background: var(--brand); }
.lg.sw.muted::before { background: var(--text-3); }

.weak-note {
  font-size: 24rpx;
  color: var(--text-2);
  margin: 10rpx 4rpx 0;
}
/* 荧光绿：本页唯一 lime 点缀（最需加强学科） */
.tag-lime {
  display: inline-block;
  background: var(--lime);
  color: var(--ink);
  font-weight: 700;
  padding: 2rpx 12rpx;
  font-size: 24rpx;
}

/* 明细表 */
.tbl { padding: 6rpx 0; }
.tbl-head, .tbl-row {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
}
.tbl-head {
  color: var(--text-3);
  font-size: 22rpx;
  border-bottom: 1rpx solid var(--border);
}
.tbl-row {
  border-bottom: 1rpx solid var(--border);
  font-size: 24rpx;
}
.tbl-row:last-child { border-bottom: none; }
.c1 { flex: 2; font-weight: 600; color: var(--text-1); }
.c2 { flex: 1; text-align: center; color: var(--text-2); }
