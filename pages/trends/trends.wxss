/* pages/trends/trends.wxss */
.chart {
  width: 100%;
  height: 440rpx;
  background: var(--card-bg);
  border-radius: 0;
  border: 1rpx solid var(--border);
  box-shadow: none;
}
.legend {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  margin: 14rpx 0 8rpx;
  font-size: 24rpx;
}
.lg.brand { color: var(--brand); font-weight: 600; }
.lg.muted { color: var(--text-3); }
.lg.amber { color: var(--warning); font-weight: 600; }

.sem-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}
.sem-row:last-child { border-bottom: none; }
.sem-tags {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.weak-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}
