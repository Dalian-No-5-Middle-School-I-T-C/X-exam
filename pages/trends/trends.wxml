<!-- pages/trends/trends.wxml -->
<view class="container">
  <view class="eyebrow">ANALYSIS · 成绩分析</view>
  <view class="title">分析</view>
  <button wx:if="{{subjects.length > 0 && !loading && !subjectsError}}" class="btn out share-btn" bindtap="onShare">一键转发学科对比 →</button>
  <!-- 骨架屏只在首次全空时出现：重试时已加载的那段仍在下方，不能再压一层骨架 -->
  <view wx:if="{{loading && trends.length === 0 && subjects.length === 0}}" class="skeleton">
    <view class="sk-card"><view class="sk sk-title"></view><view class="sk sk-block"></view></view>
    <view class="sk-card"><view class="sk sk-line w-80"></view><view class="sk sk-line w-60"></view><view class="sk sk-line w-40"></view></view>
  </view>

  <!-- 成绩走势与学科对比各自成段：一段失败或无数据，另一段照常显示 -->
  <view class="section-title">成绩走势</view>
  <view wx:if="{{error}}" class="empty {{ready ? 'show' : ''}}" bindtap="onRetry">{{error}} · 点击重试</view>
  <view wx:elif="{{trends.length === 0 && !loading}}" class="empty {{ready ? 'show' : ''}}">暂无成绩数据</view>
  <block wx:if="{{trends.length > 0}}">
    <canvas type="2d" id="lineCanvas" class="chart"></canvas>
    <view class="legend anim {{ready ? 'show' : ''}}">
      <text class="lg brand">总分</text>
      <text class="lg warn">班均</text>
      <text class="lg muted">年级均</text>
    </view>
  </block>

  <view class="section-title">学科对比</view>
  <view wx:if="{{subjectsError}}" class="empty {{ready ? 'show' : ''}}" bindtap="onRetry">{{subjectsError}} · 点击重试</view>
  <view wx:elif="{{subjects.length === 0 && !loading}}" class="empty {{ready ? 'show' : ''}}">暂无学科对比数据</view>

  <block wx:if="{{subjects.length > 0}}">
    <view class="sub-label">我的均分 vs 班级均分</view>
    <canvas wx:if="{{subjects.length >= 3}}" type="2d" id="radarCanvas" class="chart radar"></canvas>
    <view wx:if="{{subjects.length >= 3}}" class="legend">
      <text class="lg sw brand">我的均分</text>
      <text class="lg sw muted">班级均分</text>
    </view>
    <view wx:if="{{subjects.length < 3}}" class="muted sub">学科数不足 3，雷达图需至少 3 科，下方以表格呈现</view>

    <view wx:if="{{weakSubject}}" class="weak-note">
      最需加强：<text class="tag-lime">{{weakSubject}}</text>（与班级均分差距最大）
    </view>

    <view class="sub-label">学科明细</view>
    <view class="tbl card anim {{ready ? 'show' : ''}}">
      <view class="tbl-head">
        <text class="c1">学科</text>
        <text class="c2">次数</text>
        <text class="c2">均分</text>
        <text class="c2">班均</text>
        <text class="c2">差距</text>
        <text class="c2">趋势</text>
      </view>
      <view wx:for="{{subjects}}" wx:key="subject" class="tbl-row">
        <text class="c1">{{item.subject}}</text>
        <text class="c2">{{item.examCount}}</text>
        <text class="c2">{{item.avgScore}}</text>
        <text class="c2">{{item.avgClassAvg}}</text>
        <text class="c2 {{item.gapToClass >= 0 ? 'up' : 'red'}}">{{item.gapToClass >= 0 ? '+' : ''}}{{item.gapToClass}}</text>
        <text class="c2 {{item.trend === 'up' ? 'up' : (item.trend === 'down' ? 'red' : 'muted')}}">{{item.trend === 'up' ? '▲' : (item.trend === 'down' ? '▼' : '—')}}</text>
      </view>
    </view>

    <view class="sub-label">与班级均分差距</view>
    <canvas type="2d" id="barCanvas" class="chart"></canvas>
    <view class="muted sub">蓝色=高于班级均分，红色=低于班级均分</view>
  </block>

  <!-- 用时注入：没点过「一键转发」就不注入海报组件，占位期为空 view -->
  <poster wx:if="{{posterMounted}}" id="poster" bind:ready="onPosterReady" />
</view>
