/* ===== Project-X 小程序设计令牌（editorial-brutalist · Clarity V2.0） =====
   权威基准：demo-brutalist.html。蓝=品牌/正向，绯红=仅错误/异常语义。
   兼容别名：保留旧 --brand/--text-* 等变量名，全部指向新值，旧引用零改动变蓝。 */
page {
  /* 纸面 / 墨 */
  --paper: #F1EFE9;
  --paper-2: #E9E6DE;
  --sheet: #FFFFFF;
  --ink: #1A1917;
  --ink-soft: #4A4842;
  --gray: #8B887E;
  --line: #D8D5CB;
  --line-dark: #2E2E2B;

  /* 强调 */
  --blue: #2E44FF;
  --blue-deep: #1F30C8;
  --blue-soft: rgba(46, 68, 255, 0.09);
  --blue-bd: rgba(46, 68, 255, 0.35);
  --lime: #C8FF33;

  /* 错误（绯红仅错误语义） */
  --err: #C00F28;
  --err-fg: #A10D22;
  --err-soft: #FCF3F4;
  --err-bd: #F1C2C9;

  /* 深色 */
  --dark: #141413;
  --dark-2: #1D1D1B;
  --gray-on-dark: #8A887F;

  /* 阴影 / 圆角 / 字体 */
  --shadow-hard: 8rpx 8rpx 0 var(--ink);
  --r-pill: 999rpx;
  --font-sans: "PingFang SC", "Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", -apple-system, sans-serif;
  --font-mono: "SF Mono", "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;

  /* ── 兼容别名：旧变量名 → 新值（让现有 var(--brand) 等自动换肤） ── */
  --brand: #2E44FF;
  --brand-light: #5A6BFF;
  --brand-dark: #1F30C8;
  --brand-bg: rgba(46, 68, 255, 0.09);
  --page-bg: var(--paper);
  --card-bg: var(--sheet);
  --border: var(--line);
  --border-2: var(--line);
  --text-1: var(--ink);
  --text-2: var(--ink-soft);
  --text-3: var(--gray);
  --success: var(--blue);   /* 正向 / 进步 → 蓝 */
  --warning: var(--ink);    /* 进行中 / 待提升 → 墨 */
  --danger: var(--err);     /* 错误 / 退步 / 异常 → 绯红 */
  --grid: var(--line);
  --shadow-sm: none;
  --shadow: none;

  background-color: var(--paper);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 28rpx;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button, scroll-view, image { box-sizing: border-box; }

.container { padding: 28rpx 28rpx 56rpx; }

/* 标题 */
.title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: -2rpx;
  line-height: 1.15;
}
.sub { font-size: 24rpx; color: var(--text-3); font-weight: 400; letter-spacing: 0.2rpx; line-height: 1.55; }
.muted { color: var(--text-3); font-size: 24rpx; font-weight: 400; letter-spacing: 0.2rpx; }

/* 区块标题：左侧蓝色方块条（直角） */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: -1rpx;
  margin: 40rpx 6rpx 18rpx;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 34rpx;
  border-radius: 0;
  background: var(--blue);
}

/* 卡片：直角 + 1px 细线 + 无柔阴影 */
.card {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 0;
  padding: 28rpx;
}
.card text { line-height: 1.6; }
.card:active { background: #FAF8F3; }
/* 硬阴影重点卡（全工程仅 3 处：登录卡 / 成绩 hero / 天梯领奖台） */
.card--hard { box-shadow: var(--shadow-hard); border-color: var(--ink); }

/* 标签 / 学科徽标（胶囊保留） */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--blue-deep);
  background: var(--blue-soft);
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--blue-bd);
  font-weight: 600;
  line-height: 1.4;
}
.tag:active { transform: scale(0.96); }

/* 主按钮：蓝实底 + 胶囊 + 无阴影 + 按压缩小 */
.btn-primary {
  background: var(--blue);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: var(--r-pill);
  height: 92rpx;
  line-height: 92rpx;
  border: none;
  box-shadow: none;
  letter-spacing: 2rpx;
}
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.97); background: var(--blue-deep); }

/* 状态色 */
.green { color: var(--success); }
.red { color: var(--danger); }
.amber { color: var(--warning); }
.primary { color: var(--brand); }
.blue { color: var(--brand); }

/* ── 新增原语（对齐 demo-brutalist） ── */
/* 等宽眉题 */
.eyebrow {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gray);
}
.eyebrow--blue { color: var(--blue); }
/* 等宽元信息 */
.meta {
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--gray);
}
.meta--faint { color: var(--line); }
/* 数据点（等宽右对齐） */
.num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  font-weight: 700;
}
/* 深色反白块 */
.sec-dark {
  background: var(--dark);
  color: var(--paper);
  background-image: none;
}
.sec-dark .card {
  background: var(--dark-2);
  border-color: var(--line-dark);
}
/* 按钮变体 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  font-weight: 700;
  font-size: 30rpx;
  border: 1rpx solid transparent;
  line-height: 1.2;
}
.btn::after { border: none; }
.btn.out { border-color: var(--ink); color: var(--ink); background: transparent; }
.btn.out:active { background: var(--ink); color: var(--paper); transform: scale(0.98); }
.btn.gho { color: var(--ink-soft); background: transparent; }
.btn.gho:active { transform: scale(0.98); }
.btn.dan { background: var(--err); color: #fff; }
.btn.dan:active { background: var(--err-fg); transform: scale(0.98); }
/* 徽章族（直角 / 胶囊，对齐 demo b-*） */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid;
}
.b-blue { background: var(--blue); color: #fff; border-color: var(--blue); }
.b-gray { background: var(--paper-2); color: var(--ink-soft); border-color: var(--line); }
.b-amber { background: transparent; color: var(--ink); border-color: var(--ink); }
.b-red { background: var(--err-soft); color: var(--err-fg); border-color: var(--err-bd); }
.b-brand { background: var(--blue-soft); color: var(--blue-deep); border-color: var(--blue-bd); }
/* 进度条：直角 + 蓝填充 */
.prog {
  height: 12rpx;
  background: var(--paper-2);
  overflow: hidden;
  border-radius: 0;
}
.prog > i { display: block; height: 100%; background: var(--blue); }

.loading, .empty {
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 56rpx 0;
}

/* ── 导语段落（呼吸感） ── */
.lede { font-size: 30rpx; font-weight: 400; line-height: 1.7; color: var(--text-2); }

/* ── 进场动画原语（克制：缓出 ≤0.45s，无弹跳） ── */
@keyframes riseIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.anim { opacity: 0; }
.anim.show { animation: riseIn 0.42s cubic-bezier(0.22, 1, 0.36, 1) both; }
.empty.show { animation: riseIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }

/* ── 骨架屏（静态占位 + 极淡脉冲，克制不晃眼） ── */
@keyframes skPulse {
  from { opacity: 1; }
  to   { opacity: 0.55; }
}
.sk {
  background: var(--paper-2);
  border-radius: 0;
  animation: skPulse 1.2s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate;
}
.sk-card {
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  padding: 28rpx;
  margin-bottom: 18rpx;
}
.sk-title { height: 40rpx; width: 45%; margin: 10rpx 0 20rpx; }
.sk-num { height: 88rpx; width: 55%; margin: 16rpx 0; }
.sk-block { height: 320rpx; margin: 16rpx 0; }
.sk-line { height: 26rpx; margin: 14rpx 0; }
.sk-line.w-40 { width: 40%; }
.sk-line.w-60 { width: 60%; }
.sk-line.w-80 { width: 80%; }

/* ============================================================================
   皮肤 / 主题 覆盖层（切换皮肤用）
   ----------------------------------------------------------------------------
   默认 = paper-edge（纸锋）：上方 :root 即现状基准，无需重定义。
   新增维度：[data-skin="flat"]（明澈）/ [data-theme="dark"]（暗色），
   通过页面根容器 <view data-skin data-theme> 命中，覆盖同名语义变量。
   视觉基因对齐 Project-X main 仓库 tokens.css（L1/L2/L3 分层）。
   ============================================================================ */

/* 根容器：铺满屏高并随皮肤取背景/文字色（page 背景在 data-skin 作用域外，靠此覆盖） */
.app-root { min-height: 100vh; background: var(--paper); color: var(--ink); }

/* ── 明澈 flat：白底 · 绯红品牌 · 柔和阴影 ── */
[data-skin="flat"] {
  --paper: #F4F4F5;
  --paper-2: #E4E4E7;
  --sheet: #FFFFFF;
  --ink: #18181B;
  --ink-soft: #52525B;
  --gray: #71717A;
  --line: #E4E4E7;
  --line-dark: #27272A;

  --blue: #C00F28;            /* 品牌绯红 */
  --blue-deep: #A10D22;
  --blue-soft: #FCF3F4;
  --blue-bd: #F1C2C9;
  --lime: #16A34A;

  --err: #C00F28;
  --err-fg: #A10D22;
  --err-soft: #FCF3F4;
  --err-bd: #F1C2C9;

  --dark: #0B0B0D;
  --dark-2: #18181B;
  --gray-on-dark: #71717A;

  --shadow-hard: 0 2px 8px rgba(24, 24, 27, 0.10); /* 明澈用柔和阴影替代纸锋硬影 */

  /* 语义别名对齐 明澈（success=绿 / warning=琥珀 / 其余同原值） */
  --brand: #C00F28;
  --brand-light: #D95E70;
  --brand-dark: #A10D22;
  --brand-bg: #FCF3F4;
  --page-bg: var(--paper);
  --card-bg: var(--sheet);
  --border: var(--line);
  --border-2: var(--line);
  --text-1: var(--ink);
  --text-2: var(--ink-soft);
  --text-3: var(--gray);
  --success: #16A34A;
  --warning: #D97706;
  --danger: var(--err);
  --grid: var(--line);
  --shadow-sm: 0 1px 2px rgba(24, 24, 27, 0.06);
  --shadow: 0 1px 2px rgba(24, 24, 27, 0.04), 0 4px 12px rgba(24, 24, 27, 0.06);
}

/* ── 暗色（基准 = 纸锋暗，默认皮肤用） ── */
[data-theme="dark"] {
  --paper: #141413;
  --paper-2: #1D1D1B;
  --sheet: #1D1D1B;
  --ink: #F1EFE9;
  --ink-soft: #B8B5AB;
  --gray: #8A887F;
  --line: #2E2E2B;
  --line-dark: #2E2E2B;

  --blue: #4A5CFF;
  --blue-deep: #2E44FF;
  --blue-soft: rgba(46, 68, 255, 0.22);
  --blue-bd: rgba(46, 68, 255, 0.50);

  --err: #D93851;
  --err-fg: #F28393;
  --err-soft: rgba(192, 15, 40, 0.18);
  --err-bd: rgba(192, 15, 40, 0.50);

  --dark: #0B0B0D;
  --dark-2: #18181B;
  --gray-on-dark: #8A887F;

  --shadow-hard: 8px 8px 0 #000000;

  --brand: #4A5CFF;
  --brand-light: #5F70FF;
  --brand-dark: #2E44FF;
  --brand-bg: rgba(46, 68, 255, 0.22);
  --page-bg: var(--paper);
  --card-bg: var(--sheet);
  --border: var(--line);
  --border-2: var(--line);
  --text-1: var(--ink);
  --text-2: var(--ink-soft);
  --text-3: var(--gray);
  --success: #4A5CFF;
  --warning: #F1EFE9;
  --danger: var(--err);
  --grid: var(--line);
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.40);
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.40);
}

/* ── 纸锋 + 暗色 组合（显式，避免与上方 flat 暗冲突） ── */
[data-skin="paper-edge"][data-theme="dark"] {
  --blue: #4A5CFF;
  --blue-deep: #2E44FF;
  --blue-soft: rgba(46, 68, 255, 0.22);
  --blue-bd: rgba(46, 68, 255, 0.50);
  --brand: #4A5CFF;
  --success: #4A5CFF;
  --warning: #F1EFE9;
}

/* ── 明澈 + 暗色 组合 ── */
[data-skin="flat"][data-theme="dark"] {
  --paper: #101013;
  --paper-2: #1B1B20;
  --sheet: #17171B;
  --ink: #F4F4F5;
  --ink-soft: #A1A1AA;
  --gray: #8B8B94;
  --line: rgba(255, 255, 255, 0.11);
  --line-dark: rgba(255, 255, 255, 0.18);

  --blue: #D93851;
  --blue-deep: #C00F28;
  --blue-soft: rgba(217, 56, 81, 0.14);
  --blue-bd: rgba(217, 56, 81, 0.35);

  --err: #D93851;
  --err-fg: #F28393;
  --err-soft: rgba(217, 56, 81, 0.14);
  --err-bd: rgba(217, 56, 81, 0.35);

  --shadow-hard: 0 2px 8px rgba(0, 0, 0, 0.40);

  --brand: #D93851;
  --brand-light: #E0485F;
  --brand-dark: #C00F28;
  --brand-bg: rgba(217, 56, 81, 0.14);
  --page-bg: var(--paper);
  --card-bg: var(--sheet);
  --border: var(--line);
  --border-2: var(--line);
  --text-1: var(--ink);
  --text-2: var(--ink-soft);
  --text-3: var(--gray);
  --success: #22C55E;
  --warning: #FBBF24;
  --danger: var(--err);
  --grid: var(--line);
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.40);
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.40);
}

/* ── 皮肤切换器（profile 外观区 / login 调色板 共用） ── */
.skin-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; }
.skin-row + .skin-row { border-top: 1rpx solid var(--border); }
.skin-info { display: flex; flex-direction: column; gap: 4rpx; }
.skin-name { font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.skin-dot { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid var(--border); box-sizing: border-box; }
.skin-dot.on { border-color: var(--blue); box-shadow: 0 0 0 4rpx var(--blue-soft); }
.skin-dot--paper-edge { background: #2E44FF; }
.skin-dot--flat { background: #C00F28; }

.palette { display: flex; align-items: center; justify-content: center; gap: 40rpx; margin-top: 28rpx; }
.palette-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 22rpx; border: 1rpx solid var(--border); border-radius: var(--r-pill); }
.palette-name { font-size: 24rpx; color: var(--text-2); }
